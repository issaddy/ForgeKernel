# Copy to local.env (gitignored). Environment variables take precedence.

# Default: ForgeKernel, MyFlicker, and the GPU run in the same Linux container.
FK_DELIVERY=local
# CUDA device index visible inside the container.
FK_GPU=0

# MyFlicker uses the account configured inside the container.
# FK_MYFLICKER_BIN=/path/to/myflicker

# Optional: separate GPU host (FK_DELIVERY=ssh).
# REMOTE_HOST must be an SSH alias that accepts non-interactive commands.
REMOTE_HOST=
# Absolute directory dedicated to ForgeKernel. Job trees under it are replaced.
REMOTE_WORKDIR=
REMOTE_ENV_FILE=

# Optional: credentials for an explicitly selected Claude Code backend.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: path to an explicitly selected Codex CLI.
# FK_CODEX_BIN=/path/to/codex
# A provider in global_config/backends.toml reads its key from the named key_env.
